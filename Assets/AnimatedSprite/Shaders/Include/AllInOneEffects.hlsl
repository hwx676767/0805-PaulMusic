    if (_ShiftRainbow_En > 0.5) AIO_ShiftRainbow(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Overlay_En > 0.5) AIO_Overlay(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_DialogueEmphasis_En > 0.5) AIO_DialogueEmphasis(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_VoronoiCrackle_En > 0.5) AIO_VoronoiCrackle(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_MotionSmear_En > 0.5) AIO_MotionSmear(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_GlobalSmoke_En > 0.5) AIO_GlobalSmoke(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_HoloCard_En > 0.5) AIO_HolographicCard(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_CloudShadows_En > 0.5) AIO_CloudShadows(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_TrailA_En > 0.5) AIO_ColorfulTrailA(col, uv, time, worldPos, screenPos, masks, eMask);
