    half fo = 1.0-saturate(dist/_BendRadius); fo = pow(fo,_BendFalloff);
    float2 dir = normalize(delta+0.0001);
    uv += dir*fo*_BendAmount*(_BendInvert>0.5?1.0:-1.0);
    return uv;
}

// ---- Dispatch ----
float2 ApplyGroup_UV(float2 uv, half time, float3 worldPos, half4 masks, half eMask, inout half uvAlpha)
{
    if (_Pixelate_En > 0.5) { float2 _pre = uv; uv = AIO_Pixelate(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _PixelateMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_Wave_En > 0.5) { float2 _pre = uv; uv = AIO_Wave(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _WaveMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_Twist_En > 0.5) { float2 _pre = uv; uv = AIO_Twist(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _TwistMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_UVDistort_En > 0.5) { float2 _pre = uv; uv = AIO_UVDistort(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _UVDistortMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_FullDistort_En > 0.5) { float2 _pre = uv; uv = AIO_FullDistort(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _FullDistortMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_DirDistort_En > 0.5) { float2 _pre = uv; uv = AIO_DirDistort(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _DirDistortMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_UVScroll_En > 0.5) { float2 _pre = uv; uv = AIO_UVScroll(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _UVScrollMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_Rotate_En > 0.5) { float2 _pre = uv; uv = AIO_Rotate(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _RotateMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_Squeeze_En > 0.5) { float2 _pre = uv; uv = AIO_Squeeze(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _SqueezeMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_Squish_En > 0.5) { float2 _pre = uv; uv = AIO_Squish(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _SquishMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_Wiggle_En > 0.5) { float2 _pre = uv; uv = AIO_Wiggle(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _WiggleMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_Wind_En > 0.5) { float2 _pre = uv; uv = AIO_Wind(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _WindMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_WorldTiling_En > 0.5) { float2 _pre = uv; uv = AIO_WorldTiling(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _WorldTilingMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_UVScaleOffset_En > 0.5) { float2 _pre = uv; float2 _next = AIO_UVScaleOffset(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _UVScaleOffsetMaskCh); float2 _mixed = lerp(_pre, _next, _m); uvAlpha *= AtlasRectMask(_mixed); uv = ClampToAtlas(_mixed); }
    if (_CurlNoise_En > 0.5) { float2 _pre = uv; uv = AIO_CurlNoise(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _CurlNoiseMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_FBMNoise_En > 0.5) { float2 _pre = uv; uv = AIO_FBMNoise(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _FBMNoiseMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_Shockwave_En > 0.5) { float2 _pre = uv; uv = AIO_Shockwave(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _ShockwaveMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_SineScale_En > 0.5) { float2 _pre = uv; uv = AIO_SineScale(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _SineScaleMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_Heartbeat_En > 0.5) { float2 _pre = uv; uv = AIO_Heartbeat(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _HeartbeatMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_Breathing_En > 0.5) { float2 _pre = uv; uv = AIO_Breathing(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _BreathingMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_LiquidWobble_En > 0.5) { float2 _pre = uv; uv = AIO_LiquidWobble(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _LiquidWobbleMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_SmoothPixelArt_En > 0.5) { float2 _pre = uv; uv = AIO_SmoothPixelArt(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _SmoothPixelArtMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
    if (_UVBendPoint_En > 0.5) { float2 _pre = uv; uv = AIO_UVBendPoint(uv, time, worldPos); half _m = eMask * SampleEffectMask(_pre, masks, _BendMaskCh); uv = lerp(_pre, uv, _m); uv = ClampToAtlas(uv); }
