// [StrongTint] Strong Tint
void AIO_StrongTint(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _StrongTintFade * eMask * SampleEffectMask(uv,masks,_StrongTintMaskCh);
          col.rgb = lerp(col.rgb, _StrongTintColor.rgb, m * col.a);
}

// [AddColor] Add Color
void AIO_AddColor(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _AddColorFade * eMask * SampleEffectMask(uv,masks,_AddColorMaskCh);
          col.rgb += _AddColorAmount.rgb * m * col.a;
}

// [AlphaTint] Alpha Tint
void AIO_AlphaTint(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _AlphaTintFade * eMask * SampleEffectMask(uv,masks,_AlphaTintMaskCh);
          col.rgb = lerp(col.rgb, _AlphaTintColor.rgb * col.a, m);
}

// [HitEffect] Hit Effect
void AIO_HitEffect(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _HitEffectBlend * eMask * SampleEffectMask(uv,masks,_HitEffectMaskCh);
          col.rgb = lerp(col.rgb, _HitEffectColor.rgb, m * col.a);
}

// [Negative] Negative
void AIO_Negative(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _NegativeAmount * eMask * SampleEffectMask(uv,masks,_NegativeMaskCh);
          col.rgb = lerp(col.rgb, 1-col.rgb, m * col.a);
}

// [Greyscale] Greyscale
void AIO_Greyscale(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _GreyscaleBlend * eMask * SampleEffectMask(uv,masks,_GreyscaleMaskCh);
          half g = dot(col.rgb, _GreyscaleLuminosity.rgb);
          col.rgb = lerp(col.rgb, half3(g,g,g), m * col.a);
}

// [Saturation] Saturation
void AIO_Saturation(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_SaturationMaskCh);
          half g = dot(col.rgb, half3(0.299,0.587,0.114));
          col.rgb = lerp(half3(g,g,g), col.rgb, lerp(1,_SaturationAmount,m));
}

// [Brightness] Brightness
void AIO_Brightness(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_BrightnessMaskCh);
          col.rgb += _BrightnessAmount * m;
}

// [Contrast] Contrast
void AIO_Contrast(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_ContrastMaskCh);
          col.rgb = lerp(col.rgb, (col.rgb-0.5)*_ContrastAmount+0.5, m);
}

// [ColorGrading] Color Grading
void AIO_ColorGrading(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_ColorGradingMaskCh);
          half3 graded = col.rgb * pow(2, _CGExposure);
          graded = pow(max(graded, 0.001), 1.0 / _CGGamma);
          graded += _CGLift.rgb;
          col.rgb = lerp(col.rgb, graded, m);
}

// [Sepia] Sepia
void AIO_Sepia(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _SepiaIntensity * eMask * SampleEffectMask(uv,masks,_SepiaMaskCh);
          half lum = dot(col.rgb, half3(0.299,0.587,0.114));
          col.rgb = lerp(col.rgb, lum * _SepiaColor.rgb + lum * 0.2, m * col.a);
}

// [PingPongGlow] Ping Pong Glow
void AIO_PingPongGlow(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_PingPongGlowMaskCh);
          half pp = lerp(_PingPongGlowMin, _PingPongGlowMax, sin(_Time.y * _PingPongGlowSpeed) * 0.5 + 0.5);
          col.rgb += _PingPongGlowColor.rgb * pp * m * col.a;
}

// [ColorCycle] Color Cycle
void AIO_ColorCycle(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _ColorCycleFade * eMask * SampleEffectMask(uv,masks,_ColorCycleMaskCh);
          half t4 = frac(_ColorCycleSpeed * time * 0.25) * 4;
          half3 cyc;
          if(t4 < 1) cyc = lerp(_ColorCycleA.rgb, _ColorCycleB.rgb, t4);
          else if(t4 < 2) cyc = lerp(_ColorCycleB.rgb, _ColorCycleC.rgb, t4-1);
          else if(t4 < 3) cyc = lerp(_ColorCycleC.rgb, _ColorCycleD.rgb, t4-2);
          else cyc = lerp(_ColorCycleD.rgb, _ColorCycleA.rgb, t4-3);
          half lum = dot(col.rgb, half3(0.299,0.587,0.114));
          col.rgb = lerp(col.rgb, cyc * lum, m * col.a);
}

