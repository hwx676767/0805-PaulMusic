// [HealthTint] Health Tint
void AIO_HealthTint(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_HealthTintMaskCh);
          half health = saturate(_HealthTintAmount);
          half damage = 1 - health;

          half lum = dot(col.rgb, half3(0.299,0.587,0.114));
          half3 desaturated = lerp(col.rgb, half3(lum,lum,lum), _HealthDesaturation * damage * m);

          half3 tintColor = lerp(_HealthTintLowColor.rgb, _HealthTintHighColor.rgb, health);
          half3 tinted = lerp(desaturated, tintColor * lum, damage * m);

          half pulse = 1.0;
          if(_HealthPulseSpeed > 0.01)
          {
              half pulseWave = sin(_HealthPulseSpeed * time * (1 + damage * 3)) * 0.5 + 0.5;
              pulse = lerp(1.0, lerp(0.7, 1.3, pulseWave), damage * damage * m);
          }
          tinted *= pulse;

          if(_HealthVignetteStr > 0.01)
          {
              half2 vig = LocalUV(uv) - 0.5;
              half vigDist = length(vig) * 1.414;
              half vigFade = AIO_SmoothStep(0.3, 1.0, vigDist) * _HealthVignetteStr * damage * m;
              tinted = lerp(tinted, tintColor * 0.2, vigFade);
          }

          if(_HealthDamageNoise > 0.01) {
              half dmgNoise = ValueNoise(uv * 50 + time * 3) * _HealthDamageNoise * damage * m;
              tinted += dmgNoise * tintColor; }
          if(_HealthEdgeGrain > 0.01) {
              half minA = 1;
              minA = min(minA, STEX(_MainTex,sampler_MainTex,uv+float2(-1.0,-1.0)*0.01).a);
              minA = min(minA, STEX(_MainTex,sampler_MainTex,uv+float2( 0.0,-1.0)*0.01).a);
              minA = min(minA, STEX(_MainTex,sampler_MainTex,uv+float2( 1.0,-1.0)*0.01).a);
              minA = min(minA, STEX(_MainTex,sampler_MainTex,uv+float2(-1.0, 0.0)*0.01).a);
              minA = min(minA, STEX(_MainTex,sampler_MainTex,uv+float2( 1.0, 0.0)*0.01).a);
              minA = min(minA, STEX(_MainTex,sampler_MainTex,uv+float2(-1.0, 1.0)*0.01).a);
              minA = min(minA, STEX(_MainTex,sampler_MainTex,uv+float2( 0.0, 1.0)*0.01).a);
              minA = min(minA, STEX(_MainTex,sampler_MainTex,uv+float2( 1.0, 1.0)*0.01).a);
              half edgeness = col.a * (1 - minA);
              half grain = SimpleNoise(uv * 100 + time) * edgeness * _HealthEdgeGrain * damage * m;
              tinted += grain * tintColor; }
          col.rgb = tinted;
}

// [XRaySilhouette] X-Ray Silhouette
void AIO_XRaySilhouette(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _XRaySilhouetteBlend * eMask * SampleEffectMask(uv,masks,_XRaySilhouetteMaskCh);
          col.rgb = lerp(col.rgb, _XRaySilhouetteColor.rgb, m * col.a);
          col.a = lerp(col.a, col.a * _XRaySilhouetteColor.a, m);
}

// [MinimapPing] Minimap Ping
void AIO_MinimapPing(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_MinimapPingMaskCh);
          float2 mpLuv=LocalUV(uv); mpLuv.x*=_SpriteAspect; float2 mpC=half2(0.5,0.5)+_MinimapPingOffset.xy; mpC.x*=_SpriteAspect; half dist = distance(mpLuv, mpC);
          half ring = frac(dist - _MinimapPingSpeed * time * 0.2);
          half pingAlpha = 1 - AIO_SmoothStep(0, _MinimapPingWidth, abs(ring - 0.5));
          col.rgb += _MinimapPingColor.rgb * pingAlpha * m * col.a;
}

// [Blueprint] Blueprint
void AIO_Blueprint(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m=_BlueprintFade*eMask*SampleEffectMask(uv,masks,_BlueprintMaskCh);half es=_BlueprintEdgeSz;half lw=_BlueprintLineWidth;
        half eH=0;half eV=0;
        for(int k=1;k<=3;k++){half r=es*(half)k;
        eH=max(eH,abs(SampleMainClean(uv+float2(r,0)).a-SampleMainClean(uv-float2(r,0)).a));
        eV=max(eV,abs(SampleMainClean(uv+float2(0,r)).a-SampleMainClean(uv-float2(0,r)).a));}
        half edge=saturate((eH+eV)*lw);half lum=dot(col.rgb,half3(0.299,0.587,0.114));
        half lumR=dot(SampleMainClean(uv+float2(es*2,0)).rgb,half3(0.299,0.587,0.114));
        half lumU=dot(SampleMainClean(uv+float2(0,es*2)).rgb,half3(0.299,0.587,0.114));edge=max(edge,saturate(abs(lum-lumR)+abs(lum-lumU))*lw);
        half gX=step(1.0-0.03*lw,frac(uv.x*_BlueprintGridDen));half gY=step(1.0-0.03*lw,frac(uv.y*_BlueprintGridDen));half grid=max(gX,gY)*_BlueprintGridOp;
        half3 bp=lerp(_BlueprintBgCol.rgb,_BlueprintGridCol.rgb,grid);bp=lerp(bp,_BlueprintLineCol.rgb,edge*_BlueprintLineInt);col.rgb=lerp(col.rgb,bp,m*col.a);
}

// [Ghosting] Ghosting
void AIO_Ghosting(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_GhostingMaskCh);
          half4 ghost = half4(0,0,0,0);
          for(int gi = 1; gi <= (int)_GhostingCount; gi++) {
              half gfade = AIO_Pow(_GhostingFade, gi);
              ghost += SampleMainClean(uv - _GhostingOffset.xy * gi) * gfade; }
          ghost /= max(_GhostingCount, 1);
          col.rgb = lerp(col.rgb, col.rgb + ghost.rgb * 0.5, m);
          col.a = max(col.a, ghost.a * m * 0.5);
}

// [RetroPalette] Retro Palette
void AIO_RetroPalette(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _RetroFade * eMask * SampleEffectMask(uv,masks,_RetroMaskCh);
          float2 pixUV = floor(uv * _RetroPixelSize + 0.5) / _RetroPixelSize;
          half4 pixCol = SampleMainClean(pixUV);
          if (pixCol.a < 0.01) { col.a *= (1 - m); }
          else {
          half lum = dot(pixCol.rgb, half3(0.299,0.587,0.114));
          float2 ditherPos = floor(fmod(uv * _RetroPixelSize, 4));
          int didx = (int)ditherPos.x + (int)ditherPos.y * 4;
          half dbayer = (didx==0?0:didx==1?8:didx==2?2:didx==3?10:didx==4?12:didx==5?4:didx==6?14:didx==7?6:didx==8?3:didx==9?11:didx==10?1:didx==11?9:didx==12?15:didx==13?7:didx==14?13:5) / 16.0;
          half quantized = floor(lum * _RetroPaletteSize + dbayer * _RetroDitherStrength) / _RetroPaletteSize;
          half3 retro = STEX(_RetroPaletteTex, sampler_RetroPaletteTex, half2(quantized, 0.5)).rgb;
          col.rgb = lerp(col.rgb, retro, m * pixCol.a);
          col.a = lerp(col.a, pixCol.a, m); }
}

// ---- Dispatch ----
void ApplyGroup_Game(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
    if (_Checkerboard_En > 0.5) AIO_Checkerboard(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_UVVisualize_En > 0.5) AIO_UVVisualize(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_HealthTint_En > 0.5) AIO_HealthTint(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_XRaySilhouette_En > 0.5) AIO_XRaySilhouette(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_MinimapPing_En > 0.5) AIO_MinimapPing(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Blueprint_En > 0.5) AIO_Blueprint(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Ghosting_En > 0.5) AIO_Ghosting(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_RetroPalette_En > 0.5) AIO_RetroPalette(col, uv, time, worldPos, screenPos, masks, eMask);
}

#endif // _FX_GAME

// ═══ COMPOSE ═══
half4 ComposeAllEffects(float2 uv, float3 worldPos, float4 screenPos)
{
    half time = GetTime();
    if (_SpriteFlipX > 0.5) uv.x = _MinXUV + _MaxXUV - uv.x;
    if (_SpriteFlipY > 0.5) uv.y = _MinYUV + _MaxYUV - uv.y;

    half4 masks = GetEffectMasks(uv);
    half eMask = GetGlobalMask(uv) * _GlobalEffectFade;
    half uvAlpha = 1.0;
#ifdef _FX_UV
    uv = ApplyGroup_UV(uv, time, worldPos, masks, eMask, uvAlpha);
#endif
    if (_PixelArtSnap_En > 0.5) uv = PixelSnap(uv, _PixelSnapResolution);
    uv = ClampToAtlas(uv);

    // Re-sample masks after UV effects. The first mask sample is only for masking UV transforms themselves.
    // Later effects must use the transformed UV so masks travel with rotate/scale/distort effects.
    masks = GetEffectMasks(uv);
    eMask = GetGlobalMask(uv) * _GlobalEffectFade;

    half4 col = STEX(_MainTex, sampler_MainTex, uv);
    col.rgb *= smoothstep(0, 0.1, col.a);
    if (_AlphaCutoff_En > 0.5 && _AlphaCutoff > 0.001) { col.a = step(_AlphaCutoff, col.a); col.rgb *= col.a; }
#ifdef _FX_FILTER
    ApplyGroup_Filter(col, uv, time, worldPos, screenPos, masks, eMask);
#endif
    if (_PremulAlpha > 0.5 && col.a > 0.001) col.rgb /= col.a;

    #ifdef _FX_EDGE
    half4 ogCol = col;
    if (_OutlineEffectsOnly_En > 0.5) {
        half width = max(_OutlineEffectWidth, 1e-5);
        half ringA = SampleOutlineAlpha(uv, width);
        half3 outlineRGB = _OutlineColor.rgb;
        col.rgb = lerp(outlineRGB, col.rgb, step(0.01, col.a));
        col.a = ringA - col.a;
    }
    #endif
#ifdef _FX_COLOR
    ApplyGroup_Color(col, uv, time, worldPos, screenPos, masks, eMask);
#endif
#ifdef _FX_COLOR_EXT
    ApplyGroup_ColorExt(col, uv, time, worldPos, screenPos, masks, eMask);
#endif
#ifdef _FX_EDGE
    ApplyGroup_Edge(col, uv, time, worldPos, screenPos, masks, eMask);
#endif
#ifdef _FX_DISSOLVE
    ApplyGroup_Dissolve(col, uv, time, worldPos, screenPos, masks, eMask);
#endif
#ifdef _FX_VFX
    ApplyGroup_VFX(col, uv, time, worldPos, screenPos, masks, eMask);
#endif
#ifdef _FX_GAME
    ApplyGroup_Game(col, uv, time, worldPos, screenPos, masks, eMask);
#endif
    #ifdef _FX_EDGE
    if (_OutlineEffectsOnly_En > 0.5){
    col.a = max(col.a, ogCol.a);
    col.rgb = col.rgb * (1.0 - ogCol.a) + ogCol.rgb * ogCol.a;}
    #endif
    col *= uvAlpha;
    if (_PremulAlpha > 0.5) col.rgb *= col.a;
    return col;
}

// ═══ VERT / FRAG ═══

// URP main-light wrapper. Version gates use Unity's documented UNITY_XXXX_X_OR_NEWER
// macros so package-version mismatches with the Unity editor version don't silently
// pick the wrong GetMainLight signature.
#if defined(AIO_URP_3D_LIT)
    Light AIO_GetMainLight(float3 posWS, float4 sc) {
        #if defined(AIO_URP_14_PLUS) // URP 14+, Forward+ signature
            half4 shadowMask = half4(1,1,1,1);
            return GetMainLight(sc, posWS, shadowMask);
        #elif defined(AIO_URP_12_PLUS) // URP 12-13
            return GetMainLight(sc);
        #else // URP 10-11 and older
            return GetMainLight();
        #endif
    }
#endif

struct appdata { float4 vertex : POSITION; float2 uv : TEXCOORD0; half4 color : COLOR; float3 normal : NORMAL; UNITY_VERTEX_INPUT_INSTANCE_ID };
struct v2f {
    float4 pos : SV_POSITION; float2 uv : TEXCOORD0; half4 color : COLOR;
    float3 worldPos : TEXCOORD1; float3 normalWS : TEXCOORD2; float4 screenPos : TEXCOORD3;
#if defined(AIO_URP) && defined(REQUIRES_VERTEX_SHADOW_COORD_INTERPOLATOR)
    float4 shadowCoord : TEXCOORD4;
#elif defined(AIO_BUILTIN) && (defined(UNITY_PASS_FORWARDBASE) || defined(UNITY_PASS_FORWARDADD))
    UNITY_LIGHTING_COORDS(4, 5)
#endif
    UNITY_VERTEX_OUTPUT_STEREO
};

v2f vert(appdata v) {
    v2f o = (v2f)0; UNITY_SETUP_INSTANCE_ID(v); UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(o);
    if (_VertexUVExpand > 0.001) {
        // UV stays unchanged — the atlas region sampled does not shrink.
        // Vertices expand outward from mesh origin so outline/glow/shadow effects
        // have extra room to render beyond the original sprite bounds.
        float expand = _VertexUVExpand;
        v.vertex.xy *= (1.0 + expand * 2.0);
    }
    o.pos = AIO_CLIP_POS(v.vertex); o.uv = v.uv; o.color = v.color;
    o.worldPos = AIO_WORLD_POS(v.vertex);
    // Lit sprites are flat cards. Use the mesh normal so directional lighting
    // and received shadows are uniform across the whole sprite surface.
    float3 localN = dot(v.normal, v.normal) > 0.0001 ? normalize(v.normal) : float3(0, 0, -1);
#if defined(AIO_BUILTIN)
    o.normalWS = normalize(UnityObjectToWorldNormal(localN));
#elif defined(AIO_URP) || defined(AIO_HDRP)
    o.normalWS = normalize(TransformObjectToWorldNormal(localN));
#else
    o.normalWS = normalize(mul((float3x3)AIO_OBJ_TO_WORLD, localN));
#endif
    o.screenPos = AIO_ComputeScreenPos(o.pos);
#if defined(AIO_URP) && defined(REQUIRES_VERTEX_SHADOW_COORD_INTERPOLATOR)
    #if defined(_MAIN_LIGHT_SHADOWS_SCREEN) && !defined(_SURFACE_TYPE_TRANSPARENT)
        o.shadowCoord = AIO_ComputeScreenPos(o.pos);
    #else
        o.shadowCoord = TransformWorldToShadowCoord(o.worldPos);
    #endif
#elif defined(AIO_BUILTIN)
    #if defined(UNITY_PASS_FORWARDBASE) || defined(UNITY_PASS_FORWARDADD)
        UNITY_TRANSFER_LIGHTING(o, v.uv);
    #endif
    #if defined(PIXELSNAP_ON)
        o.pos = UnityPixelSnap(o.pos);
    #endif
#endif
    return o;
}

half4 frag(v2f i, bool isFrontFace : SV_IsFrontFace) : SV_Target {
    half4 col = ComposeAllEffects(i.uv, i.worldPos, i.screenPos); col *= i.color;
#if defined(AIO_CUTOUT)
    clip(col.a - _ShadowAlphaClip);
#endif

    // Two-sided lighting: flip normal for back faces so the 'other side' of the sprite
    // still receives light. Gated by _FlipNormals; when off behaves as a flat sprite.
    half3 N = AIO_GetFaceNormal(i.normalWS, isFrontFace);

#if defined(AIO_URP_2D_LIT)
    #if defined(USE_SHAPE_LIGHT_TYPE_0) || defined(USE_SHAPE_LIGHT_TYPE_1) || defined(USE_SHAPE_LIGHT_TYPE_2) || defined(USE_SHAPE_LIGHT_TYPE_3)
        half2 lightingUV = i.screenPos.xy / max(i.screenPos.w, 0.001);
        half4 lightMask = STEX(_MaskTex, sampler_MaskTex, i.uv);
        half4 colBase = col;
        // URP 12+ introduced SurfaceData2D/InputData2D structs replacing the old
        // CombinedShapeLightShared(color, mask, uv) signature. Gate on the package-version
        // define (emitted by the C# generator from PackageInfo) so shaders match the
        // actually installed URP version — not the editor version. This fixes the
        // 'cannot implicitly convert from half4 to struct SurfaceData2D' error when
        // package version and editor version disagree.
        #if defined(AIO_URP_12_PLUS)
            SurfaceData2D surfaceData; InputData2D inputData;
            InitializeSurfaceData(col.rgb, col.a, lightMask, surfaceData);
            InitializeInputData(i.uv, lightingUV, inputData);
            col = CombinedShapeLightShared(surfaceData, inputData);
        #else
            col = CombinedShapeLightShared(col, lightMask, lightingUV);
        #endif
        // Project-wide direct-light multiplier. Lerp back toward unlit color when intensity != 1.
        half3 litDelta = col.rgb - colBase.rgb;
        col.rgb = colBase.rgb + litDelta * _GlobalLightIntensity;
    #endif
#endif

#if defined(AIO_URP_3D_LIT)
    {
        // Ambient / indirect from SH probes.
        //   - Unity 6 + URP 17: SAMPLE_GI also reads Adaptive Probe Volumes (APV) when
        //     a volume is present. SampleSH alone ignores APV and would render dark
        //     in APV-only lit scenes.
        //   - Unity 2021.3 — 2022.x: SampleSH(N) is the classic path (no APV available).
        half3 ambient;
        #if defined(AIO_URP_17_PLUS)
            // URP 17+ changes SAMPLE_GI arity depending on lightmap/APV keywords.
            // SampleProbeSHVertex keeps one stable signature and still routes to APV when enabled.
            half3 bakedGI = SampleProbeSHVertex(i.worldPos, N, normalize(_WorldSpaceCameraPos - i.worldPos));
            ambient = bakedGI * _AmbientLightIntensity;
        #else
            // URP 12-16: classic SH-only path (no APV).
            ambient = SampleSH(N) * _AmbientLightIntensity;
        #endif

        // Build shadow coord. URP versions differ in whether it's interpolated (REQUIRES_...) or
        // recomputed per-pixel. The compile-time keyword is identical across URP 11-17.
        float4 sc = float4(0,0,0,0);
        #if defined(_MAIN_LIGHT_SHADOWS) || defined(_MAIN_LIGHT_SHADOWS_CASCADE) || defined(_MAIN_LIGHT_SHADOWS_SCREEN)
            #if defined(REQUIRES_VERTEX_SHADOW_COORD_INTERPOLATOR)
                sc = i.shadowCoord;
            #else
                sc = TransformWorldToShadowCoord(i.worldPos);
            #endif
        #endif
        if (_ReceiveShadows < 0.5) sc = float4(0,0,0,0);

        // Main directional light — diffused by N.L.
        Light mainLight = AIO_GetMainLight(i.worldPos, sc);
        half mainNdL = saturate(dot(N, mainLight.direction));
        half3 direct = mainLight.color * (mainLight.distanceAttenuation * mainLight.shadowAttenuation * mainNdL);

        // Additional lights:
        //   Forward+ (URP 14+): LIGHT_LOOP_BEGIN/END macros with tile-index iteration
        //   Classic (URP 10-17 with _ADDITIONAL_LIGHTS): flat count loop
        #if (defined(_FORWARD_PLUS) || defined(_CLUSTER_LIGHT_LOOP)) && defined(AIO_URP_14_PLUS)
            uint pixelLightCount = GetAdditionalLightsCount();
            InputData inputData = (InputData)0;
            inputData.positionWS = i.worldPos;
            inputData.normalWS = N;
            inputData.viewDirectionWS = GetWorldSpaceNormalizeViewDir(i.worldPos);
            inputData.normalizedScreenSpaceUV = GetNormalizedScreenSpaceUV(i.pos);
            inputData.shadowCoord = sc;
            LIGHT_LOOP_BEGIN(pixelLightCount)
                Light addLight = GetAdditionalLight(lightIndex, i.worldPos);
                half NdL = saturate(dot(N, addLight.direction));
                direct += addLight.color * (addLight.distanceAttenuation * addLight.shadowAttenuation * NdL);
            LIGHT_LOOP_END
        #elif defined(_ADDITIONAL_LIGHTS)
            uint addCount = GetAdditionalLightsCount();
            for (uint li = 0u; li < addCount; li++) {
                Light addLight = GetAdditionalLight(li, i.worldPos);
                half NdL = saturate(dot(N, addLight.direction));
                direct += addLight.color * (addLight.distanceAttenuation * addLight.shadowAttenuation * NdL);
            }
        #endif

        col.rgb *= ambient + direct * _GlobalLightIntensity;
    }
#endif

#if defined(AIO_BUILTIN) && defined(UNITY_PASS_FORWARDBASE)
    {
        half3 ambient = ShadeSH9(half4(N, 1)) * _AmbientLightIntensity;
        half3 lightDir = normalize(UnityWorldSpaceLightDir(i.worldPos));
        half NdL = saturate(dot(N, lightDir));
        UNITY_LIGHT_ATTENUATION(atten, i, i.worldPos);
        atten = (_ReceiveShadows > 0.5) ? atten : 1.0;
        half3 direct = _LightColor0.rgb * NdL * atten * _GlobalLightIntensity;
        col.rgb *= ambient + direct;
    }
#endif
#if defined(AIO_BUILTIN) && defined(UNITY_PASS_FORWARDADD)
    {
        half3 lightDir = normalize(UnityWorldSpaceLightDir(i.worldPos));
        half NdL = saturate(dot(N, lightDir));
        UNITY_LIGHT_ATTENUATION(atten, i, i.worldPos);
        atten = (_ReceiveShadows > 0.5) ? atten : 1.0;
        col.rgb *= _LightColor0.rgb * NdL * atten * _GlobalLightIntensity;
    }
#endif

    // ---- HDRP Lit ----
    // KNOWN ISSUE (Unity 6): HDRP's full LightLoop is version-specific and deeply tied to PBR
    // surfaces. Directional + point lights from HDRP do NOT automatically reach this shader;
    // only ambient/SH (baked probes / sky) contributes by default. Unity 2021 HDRP had a
    // similar limitation. This produces the 'GI works, direct lights don't' behaviour.
    //
    // Opt-in manual path: define AIO_HDRP_MANUAL_LIGHTS in your HDRP Lit .shader file to
    // iterate the exposed _DirectionalLightDatas / _LightDatas buffers directly. This is a
    // best-effort brute-force loop (no tile culling) and may need adjustment per HDRP version.
    // Test before relying on it -structure fields like DirectionalLightData.forward and
    // LightData.positionRWS have changed between HDRP versions.
#if defined(AIO_HDRP_LIT)
    {
        // --- Ambient from SH coefficients (environment/baked probes) — this always works ---
        real4 SHCoefficients[7];
        SHCoefficients[0] = unity_SHAr; SHCoefficients[1] = unity_SHAg;
        SHCoefficients[2] = unity_SHAb; SHCoefficients[3] = unity_SHBr;
        SHCoefficients[4] = unity_SHBg; SHCoefficients[5] = unity_SHBb;
        SHCoefficients[6] = unity_SHC;
        // HDRP SH9 returns Illuminance (Lux). * 1/PI → diffuse Radiance.
        half3 ambient = max(SampleSH9(SHCoefficients, N), 0.0) * 0.318309886f;
        ambient *= _AmbientLightIntensity * _HDRPAmbientMul;
        half3 direct = half3(0, 0, 0);

        // --- Opt-in manual directional + point light iteration ---
        #ifdef AIO_HDRP_MANUAL_LIGHTS
        // If you enable this define, make sure the following include is in your shader:
        //   #include "Packages/com.unity.render-pipelines.high-definition/Runtime/Lighting/LightDefinition.cs.hlsl"
        // so DirectionalLightData / LightData structs are visible. Field names below match
        // HDRP 14-17 (Unity 2022.3 – Unity 6) — older HDRP may differ.
        for (uint dli = 0u; dli < _DirectionalLightCount; dli++) {
            DirectionalLightData dl = _DirectionalLightDatas[dli];
            half NdL = saturate(dot(N, -dl.forward));
            direct += dl.color * NdL;
        }
        for (uint pli = 0u; pli < _PunctualLightCount; pli++) {
            LightData ld = _LightDatas[pli];
            float3 L = ld.positionRWS - GetCameraRelativePositionWS(i.worldPos);
            half dist = length(L);
            L /= max(dist, 1e-5);
            half NdL = saturate(dot(N, L));
            half atten = saturate(1.0 - dist * ld.rangeAttenuationScale);
            atten *= atten;
            direct += ld.color * NdL * atten;
        }
        #endif // AIO_HDRP_MANUAL_LIGHTS

        col.rgb *= ambient + direct * _GlobalLightIntensity;
    }
#endif

    // HDRP Color Buffer expects pre-exposed values; _HDRPExposureComp is in stops (×2^comp).
#if defined(AIO_HDRP_LIT) || defined(AIO_HDRP)
    #if defined(SHADERVARIABLES_INCLUDED)
        col.rgb *= GetCurrentExposureMultiplier() * exp2(_HDRPExposureComp);
    #else
        col.rgb *= exp2(_HDRPExposureComp);
    #endif
#endif

    return col;
}

half4 fragShadow(v2f i, bool isFrontFace : SV_IsFrontFace) : SV_Target {
    if (_CastShadows < 0.5) discard;
    half4 col = ComposeAllEffects(i.uv, i.worldPos, i.screenPos); col *= i.color;
    clip(col.a - _ShadowAlphaClip); return 0;
}

#if defined(AIO_URP_2D_NORMALS_PASS)
struct appdata2DNormals { float4 vertex : POSITION; float2 uv : TEXCOORD0; half4 color : COLOR; float3 normal : NORMAL; float4 tangent : TANGENT; UNITY_VERTEX_INPUT_INSTANCE_ID };
struct v2f2DNormals { float4 pos : SV_POSITION; float2 uv : TEXCOORD0; half4 color : COLOR; half3 normalWS : TEXCOORD1; half3 tangentWS : TEXCOORD2; half3 bitangentWS : TEXCOORD3; UNITY_VERTEX_OUTPUT_STEREO };

half3 AIO_UnpackNormalScale2D(half4 packedNormal, half scale) {
    half3 normalTS;
    #if defined(UNITY_NO_DXT5nm)
        normalTS = packedNormal.xyz * 2.0h - 1.0h;
        normalTS.xy *= scale;
    #else
        normalTS.xy = packedNormal.wy * 2.0h - 1.0h;
        normalTS.xy *= scale;
        normalTS.z = sqrt(saturate(1.0h - dot(normalTS.xy, normalTS.xy)));
    #endif
    return normalize(normalTS);
}

v2f2DNormals vert2DNormals(appdata2DNormals v) {
    v2f2DNormals o = (v2f2DNormals)0;
    UNITY_SETUP_INSTANCE_ID(v);
    UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(o);
    o.pos = AIO_CLIP_POS(v.vertex);
    o.uv = v.uv;
    o.color = v.color;
    float3 localN = dot(v.normal, v.normal) > 0.0001 ? normalize(v.normal) : float3(0, 0, -1);
    float3 localT = dot(v.tangent.xyz, v.tangent.xyz) > 0.0001 ? normalize(v.tangent.xyz) : float3(1, 0, 0);
    half tangentSign = v.tangent.w == 0.0 ? 1.0h : v.tangent.w;
    o.normalWS = normalize(TransformObjectToWorldNormal(localN));
    o.tangentWS = normalize(TransformObjectToWorldDir(localT));
    o.bitangentWS = normalize(cross(o.normalWS, o.tangentWS) * tangentSign);
    return o;
}

half4 frag2DNormals(v2f2DNormals i) : SV_Target {
    half alpha = STEX(_MainTex, sampler_MainTex, i.uv).a * i.color.a;
    clip(alpha - _ShadowAlphaClip);
    half3 normalTS = AIO_UnpackNormalScale2D(STEX(_NormalMap, sampler_NormalMap, i.uv), _NormalScale);
    half3 normalWS = normalize(i.tangentWS * normalTS.x + i.bitangentWS * normalTS.y + i.normalWS * normalTS.z);
    return half4(normalWS * 0.5h + 0.5h, alpha);
}
#endif

#if defined(AIO_BUILTIN)
struct v2fShadowBuiltIn {
    V2F_SHADOW_CASTER;
    float2 uv : TEXCOORD1;
    half4 color : COLOR0;
    float3 worldPos : TEXCOORD2;
    float4 screenPos : TEXCOORD3;
    UNITY_VERTEX_OUTPUT_STEREO
};

v2fShadowBuiltIn vertShadowBuiltIn(appdata v) {
    v2fShadowBuiltIn o = (v2fShadowBuiltIn)0;
    UNITY_SETUP_INSTANCE_ID(v);
    UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(o);

    if (_VertexUVExpand > 0.001) {
        float expand = _VertexUVExpand;
        v.vertex.xy *= (1.0 + expand * 2.0);
    }

    o.uv = v.uv;
    o.color = v.color;
    o.worldPos = AIO_WORLD_POS(v.vertex);
    o.screenPos = AIO_ComputeScreenPos(AIO_CLIP_POS(v.vertex));

    float3 normalOS = dot(v.normal, v.normal) > 0.0001 ? v.normal : float3(0, 0, -1);
    v.normal = normalOS;
    TRANSFER_SHADOW_CASTER_NORMALOFFSET(o)
    return o;
}

float4 fragShadowBuiltIn(v2fShadowBuiltIn i) : SV_Target {
    if (_CastShadows < 0.5)
        discard;

    half4 col = ComposeAllEffects(i.uv, i.worldPos, i.screenPos) * i.color;
    clip(col.a - _ShadowAlphaClip);
    SHADOW_CASTER_FRAGMENT(i)
}
#endif

