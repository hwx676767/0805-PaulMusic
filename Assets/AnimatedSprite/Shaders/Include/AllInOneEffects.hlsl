    if (_TrailC_En > 0.5) AIO_ColorfulTrailC(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Charging_En > 0.5) AIO_ChargingAbility(col, uv, time, worldPos, screenPos, masks, eMask);
}

