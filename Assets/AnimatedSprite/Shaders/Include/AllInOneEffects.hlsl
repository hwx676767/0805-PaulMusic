// [EnergyAura] Energy Aura
void AIO_EnergyAura(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _AuraFade * eMask * SampleEffectMask(uv,masks,_AuraMaskCh);
          half maxAlpha = 0;
          half totalAlpha = 0;
          for(int ai = 0; ai < 16; ai++)
          {
              half angle = ai * 0.3927;
              half2 dir = half2(cos(angle), sin(angle));
              for(int ri = 1; ri <= 3; ri++)
              {
                  half r = _AuraRadius * (half)ri * 0.333;
                  half sampA = SampleAtlasClamped(uv + dir * r);
                  maxAlpha = max(maxAlpha, sampA);
                  totalAlpha += sampA;
              }
          }
          half proximity = maxAlpha * (1.0 - col.a);
          half noiseVal = ValueNoise(uv * _AuraFrequency + _AuraSpeed * time * 0.3);
          half noiseVal2 = ValueNoise(uv * _AuraFrequency * 1.7 - _AuraSpeed * time * 0.2 + 50);
          half combinedNoise = noiseVal * 0.6 + noiseVal2 * 0.4;
          half wave = sin(totalAlpha * 2.0 - _AuraSpeed * time) * 0.3 + 0.7;
          half aura = proximity * combinedNoise * wave;
          col.rgb += _AuraColor.rgb * aura * _AuraIntensity * m;
          col.a = max(col.a, aura * _AuraIntensity * m);
}

// [FakeLighting] Fake Lighting
void AIO_FakeLighting(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m=_FakeLightFade*eMask*SampleEffectMask(uv,masks,_FakeLightMaskCh);half nd=_FakeLightNDist;
        half aR=SampleAtlasClamped(uv+half2(nd,0));half aL=SampleAtlasClamped(uv-half2(nd,0));half aU=SampleAtlasClamped(uv+half2(0,nd));half aD=SampleAtlasClamped(uv-half2(0,nd));
        half3 normal=normalize(half3(aL-aR,aD-aU,_FakeLightNZ));half3 ld=normalize(_FakeLightDir.xyz);half NdL=saturate(dot(normal,ld));
        half3 lit=col.rgb*(_FakeLightAmbient+_FakeLightColor.rgb*NdL*_FakeLightIntensity);half3 hd=normalize(ld+half3(0,0,1));
        lit+=_FakeLightColor.rgb*pow(saturate(dot(normal,hd)),_FakeLightSpecPow)*_FakeLightSpecInt;col.rgb=lerp(col.rgb,lit,m*col.a);
}

