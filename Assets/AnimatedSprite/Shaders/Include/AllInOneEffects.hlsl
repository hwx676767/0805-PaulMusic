// ═══ Filter (5 effects) ═══
#ifdef _FX_FILTER

// [Sharpen] Sharpen
void AIO_Sharpen(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half4 avg = (SampleMainClean(uv+half2(_SharpenSize,0))
                    +SampleMainClean(uv-half2(_SharpenSize,0))
                    +SampleMainClean(uv+half2(0,_SharpenSize))
                    +SampleMainClean(uv-half2(0,_SharpenSize)))*0.25;
        col.rgb += (col.rgb-avg.rgb)*_SharpenAmount;
}

// [GaussBlur] Gaussian Blur
void AIO_GaussBlur(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half4 blur = col;
        half gs = _GaussBlurSize;
        half q = lerp(3,7,_GaussBlurSamples);
        half total = 1;
        for(half i=1;i<=q;i++){half w=1-i/q; blur+=SampleMainClean(uv+half2(gs*i,0))*w; blur+=SampleMainClean(uv-half2(gs*i,0))*w; blur+=SampleMainClean(uv+half2(0,gs*i))*w; blur+=SampleMainClean(uv-half2(0,gs*i))*w; total+=w*4;}
        col = blur/total;
}

// [DirBlur] Directional Blur
void AIO_DirBlur(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half2 bdir = half2(cos(_DirBlurAngle),sin(_DirBlurAngle))*_DirBlurSize;
        half4 dblur = col; half dtotal = 1;
        for(half i=1;i<=_DirBlurSamples;i++){half w=1-i/_DirBlurSamples; dblur+=SampleMainClean(uv+bdir*i)*w; dblur+=SampleMainClean(uv-bdir*i)*w; dtotal+=w*2;}
        col = dblur/dtotal;
}

// [UVScrollOverlay] UV Scroll Overlay
void AIO_UVScrollOverlay(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
{ float2 overlayUV = uv * _UVScrollOverlayTiling.xy + _UVScrollOverlayTiling.zw;
          overlayUV += half2(_UVScrollOverlaySpeedX * time, _UVScrollOverlaySpeedY * time);
          half4 overlay = STEX(_UVScrollOverlayTex, sampler_UVScrollOverlayTex, overlayUV) * _UVScrollOverlayTint;
          col.rgb = lerp(col.rgb, col.rgb * overlay.rgb, _UVScrollOverlayBlend * overlay.a * col.a); }
}

// [FlipBookBlend] Flip Book Blend
void AIO_FlipBookBlend(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half4 nextFrame = STEX(_FlipBookNextFrame, sampler_FlipBookNextFrame, uv);
        if (nextFrame.a > 0.01)
            col = lerp(col, nextFrame, _FlipBookLerp);
        else
            col = lerp(col, float4(col.xyz, 0.0), _FlipBookLerp);
}

// ---- Dispatch ----
void ApplyGroup_Filter(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
    if (_Sharpen_En > 0.5) AIO_Sharpen(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_GaussBlur_En > 0.5) AIO_GaussBlur(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_DirBlur_En > 0.5) AIO_DirBlur(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_UVScrollOverlay_En > 0.5) AIO_UVScrollOverlay(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_FlipBookBlend_En > 0.5) AIO_FlipBookBlend(col, uv, time, worldPos, screenPos, masks, eMask);
}

