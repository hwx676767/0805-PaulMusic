        if(ra>0.999){col.a=0;}else if(ra>0.001){
        half2 dir=half2(cos(_BurnDirAngle),sin(_BurnDirAngle));half2 luv=LocalUV(uv);
        half d=dot(luv-0.5,dir)+0.5;
        // Dynamic extent
        half c0=dot(float2(-0.5,-0.5),dir)+0.5, c1=dot(float2(0.5,-0.5),dir)+0.5,
             c2=dot(float2(-0.5,0.5),dir)+0.5, c3=dot(float2(0.5,0.5),dir)+0.5;
        half dMin=min(min(c0,c1),min(c2,c3)), dMax=max(max(c0,c1),max(c2,c3));
        half noise=ValueNoise(uv*_BurnDirNoiseScale+time*0.3)*0.1;half ad=d+noise;
        half te=_BurnDirEdgeWidth+_BurnDirCharcoalWidth;
        half threshold=lerp(dMin-te,dMax,ra);
        half fw=0.005;
        half alive=AIO_SmoothStep(threshold,threshold+fw,ad);
        half fireMask=AIO_SmoothStep(threshold-_BurnDirEdgeWidth,threshold,ad);
        half fire=max(fireMask-alive,0);
        half charMask=AIO_SmoothStep(threshold-te,threshold-_BurnDirEdgeWidth,ad);
        half char=max(charMask-fireMask,0);
        half flicker=0.7+0.3*sin(time*8+uv.x*20);
        col.rgb=lerp(col.rgb,_BurnDirCharcoalColor.rgb,char);
        col.rgb=lerp(col.rgb,_BurnDirFireColor.rgb*flicker,fire);
        col.a*=saturate(alive+fire+char*0.8);}
}

