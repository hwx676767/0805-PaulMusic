// [VoronoiCrackle] Voronoi Crackle
void AIO_VoronoiCrackle(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _CrackleFade * eMask * SampleEffectMask(uv,masks,_CrackleMaskCh);
          half edgeDist, cellID;
          VoronoiNoise(uv * _CrackleScale, _CrackleSpeed * time, edgeDist, cellID);
          half edge = 1.0 - AIO_SmoothStep(0, _CrackleEdgeWidth, edgeDist);
          half3 cellTint = lerp(half3(1,1,1), half3(cellID, cellID*0.8, cellID*0.6), _CrackleCellTint);
          col.rgb = lerp(col.rgb * cellTint, _CrackleEdgeColor.rgb, edge * m * col.a);
}

// [MotionSmear] Motion Smear
void AIO_MotionSmear(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _SmearFade * eMask * SampleEffectMask(uv,masks,_SmearMaskCh);
          half4 smear = col;
          half2 smearDir = _SmearDirection.xy * _SmearAmount;
          int samples = max(2, (int)_SmearSamples);
          half totalW = 1;
          for(int si = 1; si <= samples; si++) {
              half t = si / (half)samples;
              half4 s = SampleMainClean(uv - smearDir * t);
              half w = 1 - t;
              smear += s * w;
              totalW += w;
          }
          smear /= totalW;
          col = lerp(col, smear, m);
          col.a = max(col.a, smear.a * m * 0.5);
}

// [GlobalSmoke] Global Smoke
void AIO_GlobalSmoke(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m=_GlobalSmokeOpacity*eMask*SampleEffectMask(uv,masks,_GlobalSmokeMaskCh);float2 su=GetScreenUV(screenPos);
        half n1=ValueNoise(su*_GlobalSmokeDensity+half2(_GlobalSmokeSpeed * time*_GlobalSmokeDir.x,_GlobalSmokeSpeed * time*_GlobalSmokeDir.y));
        half n2=ValueNoise(su*_GlobalSmokeDensity*2+half2(_GlobalSmokeSpeed * time*0.6*_GlobalSmokeDir.x,_GlobalSmokeSpeed * time*0.6*_GlobalSmokeDir.y)+100);
        half smoke=n1*n2*m;
        if (_GlobalSmokeOverlayOnly > 0.5) { col.rgb = _GlobalSmokeColor.rgb; col.a = smoke; }
        else { col.rgb=lerp(col.rgb,_GlobalSmokeColor.rgb,smoke);col.a=max(col.a,smoke*0.3); }
}

// [HolographicCard] Holographic Card
void AIO_HolographicCard(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m=_HoloCardFade*eMask*SampleEffectMask(uv,masks,_HoloCardMaskCh);float2 vd=LocalUV(uv)-0.5;
        half fresnelBase=saturate(1.0-abs(dot(vd/(length(vd)+0.00001),float2(0,1))));half fresnel=AIO_Pow(fresnelBase,max(_HoloCardFPow,0.001));half hue=frac(dot(uv,half2(1,1))*_HoloCardDensity+_HoloCardSpeed * time+fresnel*_HoloCardFShift);
        half3 foil=HSV2RGB(half3(hue,_HoloCardSat,_HoloCardBright));col.rgb=lerp(col.rgb,col.rgb+foil*fresnel,m*col.a);
        col.rgb+=foil*(sin(uv.y*_HoloCardScanDen+_HoloCardScanSpd * time)*0.5+0.5)*_HoloCardScanInt*m*col.a;
}

// [CloudShadows] Cloud Shadows
void AIO_CloudShadows(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m=_CloudShadowFade*eMask*SampleEffectMask(uv,masks,_CloudShadowMaskCh);float2 cu=worldPos.xy*_CloudShadowScale+half2(_CloudShadowSpeed.x * time, _CloudShadowSpeed.y * time);
        half cloud=ValueNoise(cu)*ValueNoise(cu*2+50);cloud=AIO_SmoothStep(_CloudShadowThresh,_CloudShadowThresh+_CloudShadowSoft,cloud);
        if (_CloudShadowOverlayOnly > 0.5) { col.rgb = half3(0,0,0); col.a = cloud * m * _CloudShadowDark; }
        else { col.rgb*=lerp(1,1-_CloudShadowDark,cloud*m); }
}

// [ColorfulTrailA] Trail - Speed Color
void AIO_ColorfulTrailA(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m=_TrailAInt*eMask*SampleEffectMask(uv,masks,_TrailAMaskCh);half spd=length(_TrailAVel.xy);if(spd>0.01 && col.a>0.01){
        half2 td=normalize(_TrailAVel.xy);half tt=dot(uv-AtlasCenter(),td)*2;half sn=saturate(spd/max(_TrailAMaxSpd,0.01));
        half tm=saturate(1-tt)*sn;
        col.rgb+=lerp(_TrailASlowCol.rgb,_TrailAFastCol.rgb,AIO_Pow(sn,_TrailACurve))*tm*m*col.a;}
}

// [ColorfulTrailB] Trail - Afterimage
void AIO_ColorfulTrailB(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m=_TrailBInt*eMask*SampleEffectMask(uv,masks,_TrailBMaskCh);half spd=length(_TrailBVel.xy);if(spd>0.01){
        half2 td=_TrailBVel.xy/max(spd,0.001);half sn=saturate(spd/max(_TrailBMaxSpd,0.01));
        half offsetScale=sn*0.08;int segs=max(2,(int)_TrailBSegs);
        half4 ghost=half4(0,0,0,0);half totalW=0;
        for(int si=1;si<=segs;si++){
        half t=(half)si/(half)segs;half w=AIO_Pow(saturate(1-t),1/max(_TrailBFade,0.01));
        ghost+=SampleMainClean(uv+td*offsetScale*(half)si)*w;totalW+=w;}
        ghost/=max(totalW,0.001);half3 tinted=ghost.rgb*_TrailBCol.rgb;
        col.rgb=lerp(col.rgb,col.rgb+tinted,m*sn*ghost.a);col.a=max(col.a,ghost.a*m*sn*0.5);}
}

// [ColorfulTrailC] Trail - Rainbow
void AIO_ColorfulTrailC(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m=_TrailCInt*eMask*SampleEffectMask(uv,masks,_TrailCMaskCh);half spd=length(_TrailCVel.xy);if(spd>0.01 && col.a>0.01){
        half2 td=normalize(_TrailCVel.xy);half tt=dot(uv-AtlasCenter(),td)*2;half sn=saturate(spd/max(_TrailCMaxSpd,0.01));
        half tm=saturate(1-tt)*sn;
        half hue=frac(_TrailCRbSpd * time+tt*0.5);half3 rc=lerp(_TrailCColA.rgb,_TrailCColB.rgb,sin(hue*6.2831)*0.5+0.5);
        rc=lerp(rc,HSV2RGB(half3(hue,1,1)),0.5);col.rgb+=rc*tm*AIO_Pow(sn,_TrailCCurve)*m*col.a;}
}

// [ChargingAbility] Charging Ability
void AIO_ChargingAbility(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _ChargeFade * eMask * SampleEffectMask(uv,masks,_ChargeMaskCh); if (col.a < 0.01 || m <= 0.001) return;
        float2 chLuv = LocalUV(uv); chLuv.x *= _SpriteAspect;
        float2 chC = _ChargeCenter.xy; chC.x *= _SpriteAspect;
        half dist = distance(chLuv, chC);
        half radius = max(_ChargeRadius, 0.0001);
        half width = max(_ChargeWidth, 0.0001);
        half ring = saturate(1.0 - abs(dist - radius) / width);
        ring = ring * ring * (3.0 - 2.0 * ring);
        half pulse = sin(_ChargeSpeed * time - dist * _ChargeFreq) * 0.5 + 0.5;
        half density = max(_ChargeDensity, 0.001);
        half gn = lerp(1.0, ValueNoise(chLuv * density + half2(_ChargeSpeed * time * 0.5, 0)), saturate(_ChargeDensity));
        half ce = ring * pulse * gn * _ChargeInt;
        half angle = atan2(chLuv.y - chC.y, chLuv.x - chC.x);
        half lineWave = abs(sin(angle * max(_ChargeLines, 1.0) + _ChargeSpeed * time * 2.0));
        half lines = pow(lineWave, 8.0) * ring;
        ce += lines * 0.5 * _ChargeInt;
        col.rgb += _ChargeColor.rgb * ce * m * col.a;
}

