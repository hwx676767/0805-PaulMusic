// [Hologram] Hologram
void AIO_Hologram(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_HologramMaskCh);
          half stripes = sin(uv.y*_HologramStripesAmount+_HologramStripesSpeed * time);
          half alpha = lerp(_HologramMinAlpha, 1, (stripes*0.5+0.5));
          col.rgb = lerp(col.rgb, _HologramColor.rgb, _HologramBlend*m);
          col.a *= lerp(1, alpha, m);
          col.rgb += (SimpleNoise(half2(floor(uv.y*100),time))-0.5)*_HologramDistortion*m;
}

// [Glitch] Glitch
void AIO_Glitch(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_GlitchMaskCh);
          half rowScale = max(_GlitchSize, 1.0);
          half row = floor(uv.y * rowScale);
          // Use stepped frames instead of feeding tiny time deltas into a hash noise.
          // _GlitchSpeed now behaves predictably as pattern updates per second:
          // 0 = static glitch, 0.01 = one update per 100 seconds, 5 = five updates per second.
          half glitchSpeed = max(_GlitchSpeed, 0.0);
          half glitchFrame = (glitchSpeed > 0.0001) ? floor(time * glitchSpeed) : 0.0;
          half glitchLine = step(0.5, SimpleNoise(float2(row + 17.0, glitchFrame + 3.0)));
          half shiftSeed = SimpleNoise(float2(row * 0.37 + 41.0, glitchFrame + 11.0));
          half shift = (shiftSeed - 0.5) * _GlitchAmount * glitchLine * m;
          if(abs(shift) > 0.001) {
              half4 origHere = SampleMainClean(uv);
              half4 shifted = SampleMainClean(uv+half2(shift,0));
              // Preserve color modifications: compute ratio of processed/original, apply to shifted
              half3 ratio = col.rgb / max(origHere.rgb, 0.01);
              col.rgb = lerp(col.rgb, shifted.rgb * ratio, shifted.a);
              col.a = max(col.a, shifted.a * 0.5);
          }
          half4 rShift = SampleMainClean(uv+half2(shift+_GlitchColorShift*m,0));
          half4 bShift = SampleMainClean(uv+half2(shift-_GlitchColorShift*m,0));
          col.r = lerp(col.r, rShift.r, rShift.a);
          col.b = lerp(col.b, bShift.b, bShift.a);
}

// [Flicker] Flicker
void AIO_Flicker(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = SampleEffectMask(uv,masks,_FlickerMaskCh);
          half flick = step(_FlickerPercent, frac(_FlickerFreq * time));
          col.a *= lerp(1, flick, m);
}

// [Shine] Shine
void AIO_Shine(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_ShineMaskCh);
          half2 shineUV = LocalUV(uv)-0.5;
          half s,c; sincos(_ShineRotation,s,c);
          half proj = shineUV.x*c+shineUV.y*s;
          half rawTravel = frac(_ShineSpeed * time);
          half speedAbs = max(abs(_ShineSpeed), 0.0001);
          half travelDuration = rcp(speedAbs);
          half totalDuration = travelDuration + max(_ShineDelay, 0.0);
          half cycleTime = frac(time / max(totalDuration, 0.0001)) * totalDuration;
          half delayedTravel = saturate(cycleTime / max(travelDuration, 0.0001));
          delayedTravel = lerp(delayedTravel, 1.0 - delayedTravel, step(_ShineSpeed, -0.0001));
          half useDelay = step(0.0001, _ShineDelay) * step(0.0001, abs(_ShineSpeed));
          half travel = lerp(rawTravel, delayedTravel, useDelay);
          half active = lerp(1.0, step(cycleTime, travelDuration), useDelay);
          half shine = saturate(1 - abs(proj - travel * 2 + 1) / _ShineWidth) * active;
          shine = AIO_Pow(shine,2)*_ShineGlow;
          col.rgb += _ShineColor.rgb*shine*m*col.a;
}

// [Smoke] Smoke
void AIO_Smoke(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _SmokeFade * eMask * SampleEffectMask(uv,masks,_SmokeMaskCh);
          half n1 = ValueNoise(uv*_SmokeDensity+half2(_SmokeSpeed * time*_SmokeDirection.x, _SmokeSpeed * time*_SmokeDirection.y));
          half n2 = ValueNoise(uv*_SmokeDensity*2+half2(_SmokeSpeed * time*0.7*_SmokeDirection.x, _SmokeSpeed * time*0.7*_SmokeDirection.y)+100);
          half n3 = ValueNoise(uv*_SmokeDensity*0.5+half2(_SmokeSpeed * time*0.3, 0)+200);
          half smoke = n1*n2;
          smoke = lerp(smoke, smoke*n3, _SmokeTurbulence);
          col.rgb = lerp(col.rgb, _SmokeColor.rgb, saturate(smoke*m*col.a*_SmokeColorStr));
}

// [Flame] Flame
void AIO_Flame(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _FlameIntensity * eMask * SampleEffectMask(uv,masks,_FlameMaskCh);
          half n1 = ValueNoise(half2(uv.x*5*_FlameDensity, uv.y*3*_FlameDensity-_FlameSpeed * time));
          half n2 = ValueNoise(half2(uv.x*8*_FlameDensity, uv.y*5*_FlameDensity-_FlameSpeed * time*1.3)+50);
          half n = n1 * 0.6 + n2 * 0.4;
          half flameShape = n * 2.0 - uv.y;

          if(_FlameExtendSides > 0.01) {
              half xDist = abs(uv.x - 0.5) * 2.0;
              // Improved pinch math: uses a curve so the bottom stays wide, but the top pinches sharply.
              // Multiplied by 5.0 to give the falloff slider a much stronger, visible effect.
              half pinch = 1.0 + AIO_Pow(uv.y, 2.0) * (_FlameSideFalloff * 5.0);
              
              // CRITICAL FIX: AIO_SmoothStep(min, max, value) followed by 1.0 - result.
              half minEdge = _FlameExtendSides * 0.2;
              half maxEdge = _FlameExtendSides;
              half sideMask = 1.0 - AIO_SmoothStep(minEdge, maxEdge, xDist * pinch);
              
              flameShape *= sideMask;
          }

          flameShape = saturate(flameShape);
          half3 flameCol = lerp(_FlameColor2.rgb, _FlameColor1.rgb, flameShape);

          if(_FlameOnlyMode > 0.5) {
              col.rgb = flameCol * flameShape * m;
              col.a = flameShape * m;
          } else {
              col.rgb += flameCol * flameShape * m * col.a;
          }
}

// [Enchanted] Enchanted
void AIO_Enchanted(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _EnchantedFade * eMask * SampleEffectMask(uv,masks,_EnchantedMaskCh);
          // 1. Create a smooth, slowly drifting base noise field
          half n = ValueNoise(uv * _EnchantedDensity + time * 0.05);

          // 2. Contour mapping: Multiply the noise to create frequency, wrap in sin()
          // Subtracting time makes the rings constantly radiate outward from the centers
          half ripples = sin(n * 30.0 - time * _EnchantedSpeed * 5.0);

          // 3. Make it 'Punchy': Separate into a sharp white-hot core and a neon glow
          half core = pow(saturate(ripples), 12.0);      // Very sharp inner line
          half glow = pow(saturate(ripples), 2.0) * 0.5; // Wider, softer aura

          // 4. Combine for high-contrast energy
          half energy = (core + glow) * _EnchantedBrightness;

          // 5. Add to the sprite (additive blend for that glowing screen effect)
          col.rgb += _EnchantedColor.rgb * energy * m * col.a;
}

// [Shifting] Shifting
void AIO_Shifting(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _ShiftingFade * eMask * SampleEffectMask(uv,masks,_ShiftingMaskCh);
          half t = sin(_ShiftingSpeed * time)*0.5+0.5;
          half3 shift = lerp(_ShiftingColor1.rgb, _ShiftingColor2.rgb, t);
          col.rgb = lerp(col.rgb, shift*dot(col.rgb,half3(0.299,0.587,0.114)), m * col.a);
}

// [ShiftRainbow] Shift Rainbow
void AIO_ShiftRainbow(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
