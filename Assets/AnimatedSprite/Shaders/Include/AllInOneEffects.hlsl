          half hue = frac(_ShiftRainbowSpeed * time+dot(uv,half2(1,1))*_ShiftRainbowDensity);
          half3 rb = HSV2RGB(half3(hue,1,1));
          half lum = dot(col.rgb,half3(0.299,0.587,0.114));
          col.rgb = lerp(col.rgb, rb*lum, m * col.a);
}

// [Overlay] Overlay
void AIO_Overlay(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
