#ifdef _FX_COLOR_EXT

// [Bloom] Bloom
void AIO_Bloom(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_BloomMaskCh);
          half lum = dot(col.rgb, half3(0.299,0.587,0.114));
          half4 blur = half4(0,0,0,0); half bTotal = 0;
          half radius = _BloomSize * _BloomSamples;
          for(int bi=-_BloomSamples/2.0;bi<=_BloomSamples/2.0;bi++) for(int bj=-_BloomSamples/2.0;bj<=_BloomSamples/2.0;bj++) {
              half bw = 1.0/(1+abs(bi)+abs(bj));
              half4 bSamp = SampleMainClean(uv+half2(bi,bj)*radius);
              blur += bSamp * bSamp.a * bw;
              bTotal += bw * bSamp.a; }
          blur /= max(bTotal, 0.001);
          half bright = 1;
          if(_BloomMode < 0.5) {
              half knee = _BloomThreshold * _BloomSoftKnee;
              half soft = lum - _BloomThreshold + knee;
              soft = clamp(soft, 0, 2*knee);
              soft = soft*soft / (4*knee+0.0001);
              bright = max(soft, lum-_BloomThreshold) / max(lum, 0.0001);
          } else if(_BloomMode < 1.5) {
              half cdist = ColorDist(col.rgb, _BloomMaskColor.rgb);
              bright = 1-AIO_SmoothStep(_BloomMaskRange-_BloomMaskSoft, _BloomMaskRange+_BloomMaskSoft+0.001, cdist);
          } else if(_BloomMode < 2.5) {
              half knee = _BloomThreshold * _BloomSoftKnee;
              half soft = lum - _BloomThreshold + knee;
              soft = clamp(soft, 0, 2*knee);
              soft = soft*soft / (4*knee+0.0001);
              half lumBright = max(soft, lum-_BloomThreshold) / max(lum, 0.0001);
              half cdist = ColorDist(col.rgb, _BloomMaskColor.rgb);
              half colorW = 1-AIO_SmoothStep(_BloomMaskRange-_BloomMaskSoft, _BloomMaskRange+_BloomMaskSoft+0.001, cdist);
              bright = max(lumBright, colorW);
          }
          half3 bloomResult = blur.rgb * bright * _BloomColor.rgb * _BloomIntensity;
          col.rgb += bloomResult * m;
          // Allow bloom to show into fully transparent pixels by raising alpha from bloom energy.
          if (_BloomAlphaBleed > 0.001)
          {
              half bloomA = saturate(max(bloomResult.r, max(bloomResult.g, bloomResult.b)));
              col.a = max(col.a, bloomA * _BloomAlphaBleed * m);
          }
}

// [ColorReplace] Color Replace
void AIO_ColorReplace(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_ColorReplaceMaskCh);
          half fade = _ColorReplaceFade * m;
          half rng = max(_ColorReplaceRange, 0.001);
          // Euclidean distance with smooth falloff for clean edges
          half d1 = length(col.rgb - _ColorReplaceSrc1.rgb);
          half r1 = 1.0 - AIO_SmoothStep(rng * 0.5, rng, d1);
          col.rgb = lerp(col.rgb, _ColorReplaceDst1.rgb, r1*fade);
          if(_ColorReplaceCount > 1.5) {
              half d2 = length(col.rgb - _ColorReplaceSrc2.rgb);
              half r2 = 1.0 - AIO_SmoothStep(rng * 0.5, rng, d2);
              col.rgb = lerp(col.rgb, _ColorReplaceDst2.rgb, r2*fade); }
          if(_ColorReplaceCount > 2.5) {
              half d3 = length(col.rgb - _ColorReplaceSrc3.rgb);
              half r3 = 1.0 - AIO_SmoothStep(rng * 0.5, rng, d3);
              col.rgb = lerp(col.rgb, _ColorReplaceDst3.rgb, r3*fade); }
          if(_ColorReplaceCount > 3.5) {
              half d4 = length(col.rgb - _ColorReplaceSrc4.rgb);
              half r4 = 1.0 - AIO_SmoothStep(rng * 0.5, rng, d4);
              col.rgb = lerp(col.rgb, _ColorReplaceDst4.rgb, r4*fade); }
}

// [LUTReplace] LUT Replace
void AIO_LUTReplace(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _LUTReplaceFade * eMask * SampleEffectMask(uv,masks,_LUTReplaceMaskCh);
          half lutN = max(_LUTSize, 2);
          half b_coord = col.b * (lutN - 1);
          half bFloor = floor(b_coord); half bFrac = b_coord - bFloor;
          half cells = lutN;
          half2 lutUV1 = half2((bFloor*lutN + col.r*(lutN-1))/(cells*lutN), col.g*(lutN-1)/lutN);
          half2 lutUV2 = half2(((bFloor+1)*lutN + col.r*(lutN-1))/(cells*lutN), col.g*(lutN-1)/lutN);
          half3 lut1 = STEX(_LUTReplaceTex, sampler_LUTReplaceTex, lutUV1).rgb;
          half3 lut2 = STEX(_LUTReplaceTex, sampler_LUTReplaceTex, lutUV2).rgb;
          col.rgb = lerp(col.rgb, lerp(lut1, lut2, bFrac), m * col.a);
}

// [Gradient] Gradient
void AIO_Gradient(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m=_GradientFade*eMask*SampleEffectMask(uv,masks,_GradientMaskCh);
        half2 gd=half2(cos(_GradientAngle),sin(_GradientAngle));
        half gT=saturate(dot(LocalUV(uv)-0.5,gd)+0.5);
        half3 gradCol = lerp(_GradientColorA.rgb, _GradientColorB.rgb, gT);
        if (_GradientUseTex > 0.5) gradCol = STEX(_GradientTex, sampler_GradientTex, half2(gT, 0.5)).rgb;
        if (_GradientBlendMode < 0.5) col.rgb = lerp(col.rgb, col.rgb + gradCol, m * col.a);
        else col.rgb = lerp(col.rgb, col.rgb * gradCol, m * col.a);
}

// [AddHue] Add Hue
void AIO_AddHue(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _AddHueFade * eMask * SampleEffectMask(uv,masks,_AddHueMaskCh);
          half hue = frac(_AddHueAmount + _AddHueSpeed * time);
          half3 added = HSV2RGB(half3(hue, _AddHueSaturation, _AddHueBrightness));
          col.rgb = lerp(col.rgb, col.rgb+added, m);
}

// [SplitToning] Split Toning
void AIO_SplitToning(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _SplitFade * eMask * SampleEffectMask(uv,masks,_SplitToningMaskCh);
          half lum = dot(col.rgb, half3(0.299,0.587,0.114));
          half gradientPos = saturate(lum + _SplitBalance * 0.5);
          half3 toned = lerp(_SplitShadowColor.rgb, _SplitMidColor.rgb, saturate(gradientPos * 2));
          toned = lerp(toned, _SplitHighlightColor.rgb, saturate(gradientPos * 2 - 1));
          col.rgb = lerp(col.rgb, toned * lum + col.rgb * (1-lum), m);
}

// [Posterize] Posterize
void AIO_Posterize(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _PosterizeFade * eMask * SampleEffectMask(uv,masks,_PosterizeMaskCh);
          half3 hsv = RGB2HSV(col.rgb);
          hsv.z = floor(hsv.z * _PosterizeSteps + 0.5) / _PosterizeSteps;
          hsv.y = floor(hsv.y * max(_PosterizeSteps * 0.5, 2) + 0.5) / max(_PosterizeSteps * 0.5, 2);
          half3 poster = HSV2RGB(hsv);
          col.rgb = lerp(col.rgb, poster, m * col.a);
}

// [Poison] Poison
void AIO_Poison(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _PoisonFade * eMask * SampleEffectMask(uv,masks,_PoisonMaskCh);
          half n = ValueNoise(uv*_PoisonDensity+_PoisonSpeed * time);
          half3 poisonCol = lerp(_PoisonColor.rgb, _PoisonColor2.rgb, n);
          poisonCol = lerp(poisonCol, _PoisonColor3.rgb, ValueNoise(uv*_PoisonDensity*1.7+_PoisonSpeed * time*0.6+50));
          col.rgb = lerp(col.rgb, poisonCol*n, m * col.a);
}

// [Frozen] Frozen
void AIO_Frozen(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _FrozenFade * eMask * SampleEffectMask(uv, masks, _FrozenMaskCh);
            half lum = dot(col.rgb, half3(0.299, 0.587, 0.114));
            // Frost base: blend between two ice colors based on UV + luminance
            half iceT = saturate(lum * _FrozenContrast);
            half crystalPattern = frac(uv.x * 6 + uv.y * 6) * 0.3 + 0.7;
            half3 frostBase = lerp(_FrozenColor.rgb, _FrozenColor2.rgb, iceT * crystalPattern);
            // Highlights: edge sparkle controlled by Highlight param
            half edgeSparkle = pow(saturate(fwidth(frac(uv.x * 8 + uv.y * 6)) * 8), 2);
            half specular = pow(max(lum,0.0001), 3) * 0.5 + edgeSparkle * 0.5;
            half3 frozen = frostBase + _FrozenHighlightColor.rgb * specular * _FrozenHighlight;
            // Contrast: control how much original luminance structure shows through
            frozen = lerp(frostBase, frozen, saturate(lum * _FrozenContrast));
            col.rgb = lerp(col.rgb, frozen, m * col.a);
}

// [Metal] Metal
void AIO_Metal(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _MetalFade * eMask * SampleEffectMask(uv,masks,_MetalMaskCh);
          half lum = dot(col.rgb, half3(0.299,0.587,0.114));
          half shine = sin(uv.x*30+uv.y*20+_MetalSpeed * time)*0.5+0.5;
          half3 metalBase = lerp(_MetalColor.rgb, _MetalColor2.rgb, lum);
          half3 metal = metalBase * pow(max(lum,0.0001), 1/_MetalContrast) + _MetalHighlight.rgb*shine*pow(max(lum,0.0001),2);
          col.rgb = lerp(col.rgb, metal, m * col.a);
}

// [Camouflage] Camouflage
void AIO_Camouflage(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _CamoFade * eMask * SampleEffectMask(uv,masks,_CamouflageMaskCh);
          half n1=ValueNoise(uv*_CamoScale+_CamoSpeed * time);
          half n2=ValueNoise(uv*_CamoScale*1.5+_CamoSpeed * time*0.7+100);
          half3 camo = n1<0.33 ? _CamoColor1.rgb : (n1<0.66 ? _CamoColor2.rgb : _CamoColor3.rgb);
          camo = lerp(camo, n2<0.5?_CamoColor1.rgb:_CamoColor3.rgb, 0.3);
          col.rgb = lerp(col.rgb, camo, m * col.a);
}

// [Rainbow] Rainbow
void AIO_Rainbow(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _RainbowFade * eMask * SampleEffectMask(uv,masks,_RainbowMaskCh);
          half hue = frac(uv.x*_RainbowDensity + _RainbowSpeed * time);
          half3 rb = HSV2RGB(half3(hue, _RainbowSaturation, _RainbowBrightness));
          col.rgb = lerp(col.rgb, rb, m * col.a);
}

// [BlackTint] Black Tint
void AIO_BlackTint(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _BlackTintFade * eMask * SampleEffectMask(uv,masks,_BlackTintMaskCh);
          half lum = dot(col.rgb, half3(0.299,0.587,0.114));
          half w = saturate(1-lum/_BlackTintThreshold);
          col.rgb = lerp(col.rgb, _BlackTintColor.rgb, w*m);
}

// [Chromatic] Chromatic Aberration
void AIO_Chromatic(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_ChromaticMaskCh);
          half2 dir;
          if(_ChromaMode < 0.5) {
              dir = half2(cos(_ChromaticAngle),sin(_ChromaticAngle))*_ChromaticAmount*m;
          } else {
              half2 delta = uv - _ChromaRadialCenter.xy;
              dir = delta * _ChromaticAmount * length(delta) * m;
          }
          half4 rSamp = SampleMainClean(uv+dir);
          half4 bSamp = SampleMainClean(uv-dir);
          col.r = lerp(col.r, rSamp.r, rSamp.a);
          col.b = lerp(col.b, bSamp.b, bSamp.a);
}

// [PaletteSwap] Palette Swap
void AIO_PaletteSwap(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _PaletteSwapFade * eMask * SampleEffectMask(uv,masks,_PaletteSwapMaskCh);
          half lum = dot(col.rgb, half3(0.299,0.587,0.114));
          half idx = floor(lum * (_PaletteSwapColors - 0.001)) / max(_PaletteSwapColors - 1, 1);
          half3 palCol = STEX(_PaletteSwapTex, sampler_PaletteSwapTex, half2(idx, 0.5)).rgb;
          col.rgb = lerp(col.rgb, palCol, m);
}

// [Dithering] Dithering
void AIO_Dithering(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _DitheringFade * eMask * SampleEffectMask(uv,masks,_DitheringMaskCh);
          float2 ditherCoord = _DitheringScreenSpace > 0.5 ? float2(GetScreenUV(screenPos).x * _ScreenParams.x/_ScreenParams.y, GetScreenUV(screenPos).y) : uv;
          float2 ditherPos = floor(fmod(ditherCoord * _DitheringSize * 64, 4));
          int idx = (int)ditherPos.x + (int)ditherPos.y * 4;
          half bayer = (idx==0?0:idx==1?8:idx==2?2:idx==3?10:idx==4?12:idx==5?4:idx==6?14:idx==7?6:idx==8?3:idx==9?11:idx==10?1:idx==11?9:idx==12?15:idx==13?7:idx==14?13:5) / 16.0;
          half lum = dot(col.rgb, half3(0.299,0.587,0.114));
          half quantized = floor(lum * _DitheringLevels + bayer) / _DitheringLevels;
          half3 dithered = col.rgb * (quantized / max(lum, 0.001));
          col.rgb = lerp(col.rgb, dithered, m);
          if(_DitheringAlphaMode > 0.5) {
              half alphaDither = step(bayer + 0.002, col.a * _DitheringAlphaThreshold);
              col.a *= lerp(1, alphaDither, m);
          }
}

// [CRTScanlines] CRT Scanlines
void AIO_CRTScanlines(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_CRTScanlinesMaskCh);
          float2 cuv = LocalUV(uv) - 0.5;
          cuv *= 1.0 + dot(cuv, cuv) * _CRTCurvature * 8.0;
          cuv += 0.5;
          half scanline = sin((cuv.y + _CRTSpeed * time * 0.01) * _CRTDensity * 3.14159) * 0.5 + 0.5;
          col.rgb *= lerp(1, 1 - scanline * _CRTIntensity, m);
}

// [Vignette] Vignette
void AIO_Vignette(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_VignetteMaskCh);
          float2 vigLuv = LocalUV(uv); vigLuv.x *= _SpriteAspect; half2 vigC = _VignetteCenter.xy + _VignetteOffset.xy; vigC.x *= _SpriteAspect; half2 vig = vigLuv - vigC;
          half vigDist = length(vig);
          half outerEdge = 0.707;
          half innerEdge = outerEdge * (1.0 - _VignetteIntensity);
          half vigFactor = AIO_SmoothStep(innerEdge, innerEdge + _VignetteSmoothness * outerEdge, vigDist);
          col.rgb = lerp(col.rgb, _VignetteColor.rgb, vigFactor * m);
          col.a *= lerp(1.0, 1.0 - vigFactor * _VignetteAlpha, m);
}

// [ThermalVision] Thermal Vision
void AIO_ThermalVision(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _ThermalIntensity * eMask * SampleEffectMask(uv,masks,_ThermalVisionMaskCh);
          half lum = dot(col.rgb, half3(0.299,0.587,0.114));
          half3 thermal = lerp(half3(0,0,0.2), half3(0.5,0,0.5), saturate(lum*4));
          thermal = lerp(thermal, half3(1,0.2,0), saturate(lum*4-1));
          thermal = lerp(thermal, half3(1,1,0), saturate(lum*4-2));
          thermal = lerp(thermal, half3(1,1,1), saturate(lum*4-3));
          // HDR glow: push bright areas beyond 1.0 for bloom post-processing
          thermal *= 1.0 + _ThermalHDRGlow * lum * 2.0;
          col.rgb = lerp(col.rgb, thermal, m * col.a);
}

// [RecolorRGB] Recolor RGB
void AIO_RecolorRGB(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _RecolorFade * eMask * SampleEffectMask(uv,masks,_RecolorRGBMaskCh);
          half3 recolored = col.r * _RecolorR.rgb + col.g * _RecolorG.rgb + col.b * _RecolorB.rgb;
          half3 cmy = (1 - col.r) * _RecolorCyan.rgb * 0.33 + (1 - col.g) * _RecolorMagenta.rgb * 0.33 + (1 - col.b) * _RecolorYellow.rgb * 0.33;
          col.rgb = lerp(col.rgb, recolored + cmy, m * col.a);
}

// [WaterReflect] Water Reflection
void AIO_WaterReflect(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _WaterReflectFade * eMask * SampleEffectMask(uv,masks,_WaterReflectMaskCh);
          half yStart = _WaterReflectYPoint;
          if(uv.y < yStart) {
              half reflectY = yStart + (yStart - uv.y);
              half2 reflUV = half2(uv.x, reflectY);
              half waveOff = sin(uv.x * _WaterReflectWaveFreq + _WaterReflectWaveSpeed * time) * _WaterReflectWaveAmp;
              reflUV.x += waveOff; reflUV.y += waveOff * 0.3;
              reflUV = ClampToAtlas(reflUV);
              half4 reflCol = SampleMainClean(reflUV);
              half depth = saturate((yStart - uv.y) / max(_WaterReflectDepth, 0.001));
              half rayFade = 1.0 - depth; rayFade *= rayFade;
              half3 waterTinted = lerp(reflCol.rgb, _WaterReflectTint.rgb, _WaterReflectTintAmount * depth);
              col.rgb = lerp(col.rgb, waterTinted, rayFade * m * reflCol.a * _WaterReflectOpacity);
              col.a = max(col.a, reflCol.a * rayFade * m * _WaterReflectOpacity);
          }
}

// [HueShift] Hue Shift
void AIO_HueShift(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = _HueShiftFade * eMask * SampleEffectMask(uv,masks,_HueShiftMaskCh);
          half3 hsv = RGB2HSV(col.rgb);
          hsv.x = frac(hsv.x + _HueShiftAmount + _HueShiftSpeed * time);
          half3 shifted = HSV2RGB(hsv);
          col.rgb = lerp(col.rgb, shifted, m);
}

// [RadialGradient] Radial Gradient
void AIO_RadialGradient(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m=_RadialGradFade*eMask*SampleEffectMask(uv,masks,_RadialGradMaskCh);
        float2 rgLuv=LocalUV(uv); rgLuv.x*=_SpriteAspect; float2 rgC=_RadialGradCenter.xy; rgC.x*=_SpriteAspect; half t=saturate(distance(rgLuv,rgC)/_RadialGradRadius);
        half3 gradCol=lerp(_RadialGradCenterColor.rgb,_RadialGradEdgeColor.rgb,t);
        if (_RadialGradUseTex > 0.5) gradCol = STEX(_RadialGradTex, sampler_RadialGradTex, half2(t, 0.5)).rgb;
        if (_RadialGradBlendMode < 0.5) col.rgb=lerp(col.rgb,col.rgb+gradCol,m*col.a);
        else col.rgb=lerp(col.rgb,col.rgb*gradCol,m*col.a);
}

// [ColorRamp] Color Ramp
void AIO_ColorRamp(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m=_ColorRampFade*eMask*SampleEffectMask(uv,masks,_ColorRampMaskCh);
        half3 rampColor;
        if (_ColorRampMode < 0.5) {
            rampColor.r = STEX(_ColorRampTex,sampler_ColorRampTex,half2(col.r,0.5)).r;
            rampColor.g = STEX(_ColorRampTex,sampler_ColorRampTex,half2(col.g,0.5)).g;
            rampColor.b = STEX(_ColorRampTex,sampler_ColorRampTex,half2(col.b,0.5)).b;
        } else if (_ColorRampMode < 1.5) {
            half lum=dot(col.rgb,half3(0.299,0.587,0.114));
            rampColor=STEX(_ColorRampTex,sampler_ColorRampTex,half2(lum,0.5)).rgb;
        } else {
            half lum=dot(col.rgb,half3(0.299,0.587,0.114));
            rampColor=lerp(_ColorRampColorA.rgb,_ColorRampColorB.rgb,lum);
        }
        rampColor*=_ColorRampIntensity;
        col.rgb=lerp(col.rgb,rampColor,m*col.a);
}

// ---- Dispatch ----
void ApplyGroup_ColorExt(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
    if (_Bloom_En > 0.5) AIO_Bloom(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_ColorReplace_En > 0.5) AIO_ColorReplace(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_LUTReplace_En > 0.5) AIO_LUTReplace(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Gradient_En > 0.5) AIO_Gradient(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_AddHue_En > 0.5) AIO_AddHue(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_SplitToning_En > 0.5) AIO_SplitToning(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Posterize_En > 0.5) AIO_Posterize(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Poison_En > 0.5) AIO_Poison(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Frozen_En > 0.5) AIO_Frozen(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Metal_En > 0.5) AIO_Metal(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Camouflage_En > 0.5) AIO_Camouflage(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Rainbow_En > 0.5) AIO_Rainbow(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_BlackTint_En > 0.5) AIO_BlackTint(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Chromatic_En > 0.5) AIO_Chromatic(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_PaletteSwap_En > 0.5) AIO_PaletteSwap(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Dithering_En > 0.5) AIO_Dithering(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_CRTScanlines_En > 0.5) AIO_CRTScanlines(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_Vignette_En > 0.5) AIO_Vignette(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_ThermalVision_En > 0.5) AIO_ThermalVision(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_RecolorRGB_En > 0.5) AIO_RecolorRGB(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_WaterReflect_En > 0.5) AIO_WaterReflect(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_HueShift_En > 0.5) AIO_HueShift(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_RadialGradient_En > 0.5) AIO_RadialGradient(col, uv, time, worldPos, screenPos, masks, eMask);
    if (_ColorRamp_En > 0.5) AIO_ColorRamp(col, uv, time, worldPos, screenPos, masks, eMask);
}

#endif // _FX_COLOR_EXT

// ═══ Edge (15 effects) ═══
#ifdef _FX_EDGE

// [Outline] Outline
void AIO_Outline(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv, masks, _OutlineMaskCh);

            half maxA = SampleOutlineAlpha(uv, _OutlineSize);
            half outline = MaskOutline(maxA, col.a) * _OutlineAlpha;
            half aa = _OutlineAA > 0.001 ? AIO_SmoothStep(0, _OutlineAA, outline) : outline;
            col = half4(lerp(col.rgb, _OutlineColor.rgb, aa * m), max(col.a, aa * m));
}

// [InnerOutline] Inner Outline
void AIO_InnerOutline(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv, masks, _InnerOutlineMaskCh);
            half inner = SampleInverseOutlineAlpha(uv, _InnerOutlineThickness) * _InnerOutlineAlpha;
            col.rgb = lerp(col.rgb, _InnerOutlineColor.rgb, inner * m * col.a);
}

// [TexOutline] Texture Outline
void AIO_TexOutline(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv, masks, _TexOutlineMaskCh);
            half maxA = SampleOutlineAlpha(uv, _TexOutlineSize);
            half outline = MaskOutline(maxA, col.a);
            float2 texUV = uv * _TexOutlineTiling.xy + _TexOutlineTiling.zw + half2(_TexOutlineSpeed.x * time, _TexOutlineSpeed.y * time);
            half4 texCol = STEX(_TexOutlineTex, sampler_TexOutlineTex, texUV);
            half4 outCol = texCol * _TexOutlineColor;
            col = half4(lerp(col.rgb, outCol.rgb, outline * m), max(col.a, outline * m));
}

// [RainbowOutline] Rainbow Outline
void AIO_RainbowOutline(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv, masks, _RainbowOutlineMaskCh);
            half maxA = SampleOutlineAlpha(uv, _RainbowOutlineSize);
            half outline = MaskOutline(maxA, col.a);
            half density = max(_RainbowOutlineDensity, 0.0001);
            half hue = frac((uv.x + uv.y) * density + _RainbowOutlineSpeed * time);
            half3 rb = HSV2RGB(half3(hue, 1, 1)) * _RainbowOutlineColor.rgb;
            col = half4(lerp(col.rgb, rb, outline * m), max(col.a, outline * m));
}

// [DistortOutline] Distort Outline
void AIO_DistortOutline(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv, masks, _DistortOutlineMaskCh);
            half actualSize = ((_DistortOutlineSize > 0.1) ? (_DistortOutlineSize * 0.015) : _DistortOutlineSize);
            half noise = sin(uv.y * 50 + _DistortOutlineSpeed * time) * _DistortOutlineAmount;
            half distortedA = SampleOutlineAlpha(uv + half2(noise, 0), actualSize);
            half normalA = SampleOutlineAlpha(uv, actualSize);
            half maxA = max(distortedA, normalA);
            half outline = MaskOutline(maxA, col.a);
            col = half4(lerp(col.rgb, _DistortOutlineColor.rgb, outline * m), max(col.a, outline * m));
}

// [Glow] Glow
void AIO_Glow(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_GlowMaskCh);
          half glowA = 0;
          if(_OutlineMode > 1.5) {
              half sdf = SampleSDF(uv);
              half gAvgTexel = (_MainTex_TexelSize.x + _MainTex_TexelSize.y) * 0.5;
              half glowPx = _GlowSize / max(gAvgTexel, 1e-6);
              half glowSdfW = glowPx / max(_OutlineSDFSpread * 2, 1);
              half glowFade = AIO_SmoothStep(0.5 - glowSdfW, 0.5, sdf);
              glowA = glowFade * (1.0 - AIO_SmoothStep(0.5, 0.5 + fwidth(sdf), sdf));
          } else {
              half total=0;
              for(int gx=-2;gx<=2;gx++) for(int gy=-2;gy<=2;gy++) {
                  half w = 1.0/(1+abs(gx)+abs(gy));
                  glowA += SampleAtlasClamped(uv+half2(gx,gy)*_GlowSize)*w;
                  total += w; }
              glowA = glowA/total*(1-col.a);
          }
          col.rgb += _GlowColor.rgb*glowA*_GlowIntensity*m;
          col.a = max(col.a, glowA*m);
}

// [Shadow] Shadow
void AIO_Shadow(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_ShadowMaskCh);
          half4 shadow = SampleMainClean(uv-_ShadowOffset.xy);
          half shadowA = shadow.a * _ShadowColor.a * (1-col.a);
          col = lerp(col, half4(_ShadowColor.rgb,1), shadowA*m);
}

// [SoftShadow] Soft Shadow
void AIO_SoftShadow(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv,masks,_SoftShadowMaskCh);
          half shadowA = 0; half total = 0;
          int samples = (int)_SoftShadowSamples;
          for(int sx=-samples;sx<=samples;sx++) for(int sy=-samples;sy<=samples;sy++) {
              half w = 1.0/(1+abs(sx)+abs(sy));
              float2 sampleUV = ClampToAtlas(uv-_SoftShadowOffset.xy+half2(sx,sy)*_SoftShadowSoftness);
              shadowA += SampleMainClean(sampleUV).a * w;
              total += w; }
          shadowA = shadowA/total * _SoftShadowColor.a * (1-col.a);
          col = lerp(col, half4(_SoftShadowColor.rgb,1), shadowA*m);
}

// [DirOutline] Directional Outline
void AIO_DirOutline(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = eMask * SampleEffectMask(uv, masks, _DirOutlineMaskCh);
            if (col.a < 0.01) return;
            half nd = _DirOutlineWidth;
            half aR = SampleAtlasClamped(uv + half2(nd, 0));
            half aL = SampleAtlasClamped(uv - half2(nd, 0));
            half aU = SampleAtlasClamped(uv + half2(0, nd));
            half aD = SampleAtlasClamped(uv - half2(0, nd));
            half2 normal2D = half2(aL - aR, aD - aU);
            half edgeness = length(normal2D);
            if (_OutlineMode > 1.5) {
                half sR = SampleSDF(uv + half2(nd, 0));
                half sL = SampleSDF(uv - half2(nd, 0));
                half sU = SampleSDF(uv + half2(0, nd));
                half sD = SampleSDF(uv - half2(0, nd));
