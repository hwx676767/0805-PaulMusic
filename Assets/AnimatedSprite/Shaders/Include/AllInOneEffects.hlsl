// [Dissolve] Dissolve
void AIO_Dissolve(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = SampleEffectMask(uv,masks,_DissolveMaskCh);
          half rawAmount = _DissolveAmount;
          if (rawAmount > 0.999) { col.a = 0; }
          else if (rawAmount > 0.001) {
          float2 noiseUV = uv + half2(time*_DissolveNoiseSpeed, 0);
          half4 texSample = half4(0.5,0.5,0.5,1);
          if(_DissolveNoiseType < 0.5)
              texSample = STEX(_DissolveTex,sampler_DissolveTex,noiseUV * _DissolveTiling.xy + _DissolveTiling.zw);
          half noise = SampleNoise(noiseUV, _DissolveNoiseType, _DissolveNoiseScale, texSample) + (1.0 - m); // Mask offsets noise: protected areas need higher amount to dissolve
          half totalBorder = _DissolveBorderWidth + _DissolveBurnWidth;
          half edge = totalBorder + 0.01;
          half threshold = lerp(-edge, 1.0, rawAmount);
          half fw = 0.005;
          half dissolve = AIO_SmoothStep(threshold, threshold + fw, noise);
          half borderMask = AIO_SmoothStep(threshold - _DissolveBorderWidth, threshold, noise);
          half border = max(borderMask - dissolve, 0);
          half burn = 0;
          if(_DissolveBurnWidth > 0.001) {
              half burnMask = AIO_SmoothStep(threshold - totalBorder, threshold - _DissolveBorderWidth, noise);
              burn = max(burnMask - borderMask, 0); }
          half3 fireEdge = lerp(_DissolveBurnColor.rgb, _DissolveBorderColor.rgb, saturate(border * 5.0));
          half edgeAlpha = saturate(border + burn);
          col.rgb = lerp(col.rgb, fireEdge, edgeAlpha);
          col.a *= saturate(dissolve + edgeAlpha); }
}

// [GlowDissolve] Glow Dissolve
void AIO_GlowDissolve(inout half4 col, float2 uv, half time, float3 worldPos, float4 screenPos, half4 masks, half eMask)
{
half m = SampleEffectMask(uv,masks,_GlowDissolveMaskCh);
          half rawAmt = _GlowDissolveAmount;
