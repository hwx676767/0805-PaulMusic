          half4 texSample = STEX(_GlowDissolveTex,sampler_GlowDissolveTex,uv);
          half noise = SampleNoise(uv, _GlowDissolveNoiseType, _GlowDissolveNoiseScale, texSample) + (1.0 - m);
          half glowW = max(_GlowDissolveWidth, 0.001);
          half edge = glowW + 0.01;
          half threshold = lerp(-edge, 1.0, rawAmt);
          half fw = 0.005;
